<div class="quest-window">
    {{#if quests.length}}
            {{#if isGM}}
            <div class="scrollbar">
                <div class="note-header-text">
                <h3 class="quest-header">Active Quests</h3>
                </div>
                
                <div class="quest-list">
                {{#each activeQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>Start Date: {{this.flagData.startDate.day}} {{this.flagData.startDate.month}}, {{this.flagData.startDate.year}}</p>
                    </div>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">Inactive Quests</h3>
                </div>
                <div class="quest-list">
                {{#each inactiveQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>Start Date: {{this.flagData.startDate.day}} {{this.flagData.startDate.month}}, {{this.flagData.startDate.year}}</p>
                    </div>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">Completed Quests</h3>
                </div>
                <div class="quest-list">
                {{#each completedQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>Start Date: {{this.flagData.startDate.day}} {{this.flagData.startDate.month}}, {{this.flagData.startDate.year}}</p>
                    </div>
                {{/each}}
                </div>
            </div>
            {{else}}
            <div class="scrollbar">
                <div class="note-header-text">
                <h3 class="quest-header">Active Quests</h3>
                </div>
                <div class="quest-list">
                {{#each activeQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>Start Date: {{this.flagData.startDate.day}} {{this.flagData.startDate.month}}, {{this.flagData.startDate.year}}</p>
                    </div>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">Completed Quests</h3>
                </div>
                <div class="quest-list">
                {{#each completedQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>Start Date: {{this.flagData.startDate.day}} {{this.flagData.startDate.month}}, {{this.flagData.startDate.year}}</p>
                    </div>
                {{/each}}
                </div>
            </div>
            {{/if}}

    {{else}}

        <p>No quests available.</p>

    {{/if}}
</div>