<div class="quest-window">
    {{#if quests.length}}
            {{#if isGM}}
            <div class="scrollbar">
                <div class="note-header-text">
                <h3 class="quest-header">{{localize "activeQuest"}}</h3>
                </div>
                
                <div class="quest-list">
                {{#each activeQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>{{localize "startDate"}}: {{this.startDate}}</p>
                    </div>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">{{localize "inactiveQuest"}}</h3>
                </div>
                <div class="quest-list">
                {{#each inactiveQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>{{localize "startDate"}}: {{this.startDate}}</p>
                    </div>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">{{localize "completedQuest"}}</h3>
                </div>
                <div class="quest-list">
                {{#each completedQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>{{localize "startDate"}}: {{this.startDate}}</p>
                    </div>
                {{/each}}
                </div>
            </div>
            {{else}}
            <div class="scrollbar">
                <div class="note-header-text">
                <h3 class="quest-header">{{localize "activeQuest"}}</h3>
                </div>
                <div class="quest-list">
                {{#each activeQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>{{localize "startDate"}}: {{this.startDate}}</p>
                    </div>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">{{localize "completedQuest"}}</h3>
                </div>
                <div class="quest-list">
                {{#each completedQuests}}
                    <div class="quest-link" data-note-id="{{this.id}}" role="button">
                        <p class="quest-name">{{this.name}}</p>
                        <p>{{localize "startDate"}}: {{this.startDate}}</p>
                    </div>
                {{/each}}
                </div>
            </div>
            {{/if}}

    {{else}}

        <p>{{localize "noQuests"}}</p>

    {{/if}}
</div>