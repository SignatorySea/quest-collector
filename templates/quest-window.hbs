<div class="quest-window">

    {{#if quests.length}}
            {{#if isGM}}
            <div class="scrollbar">
                <div class="note-header-text">
                <h3 class="quest-header">Active Quests</h3>
                </div>
                
                <div class="quest-list">
                {{#each activeQuests}}
                    <button class="quest-link " data-note-id="{{this.id}}">
                        {{this.name}}
                    </button>
                {{/each}}
                </div>
                <div class="note-header-text">
                <h3 class="quest-header">Inactive Quests</h3>
                </div>
                <div class="quest-list">
                {{#each inactiveQuests}}
                    <button class="quest-link" data-note-id="{{this.id}}">
                        {{this.name}}
                    </button>
                {{/each}}
                </div>
            </div>
            {{else}}
            <div class="scrollbar">
                {{#each quests}}
                    <button type = "button", class="quest-link", data-note-id="{{this.id}}">
                        {{this.name}}
                    </button>
                {{/each}}
            </div>
            {{/if}}

    {{else}}

        <p>No quests available.</p>

    {{/if}}
</div>